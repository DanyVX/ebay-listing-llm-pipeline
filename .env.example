# All costs USD. Zero by default: paid requests fail closed.
ELP_MAX_RUN_COST_USD=0
ELP_MAX_DAY_COST_USD=0
# Local budget ledger; database files are gitignored.
ELP_BUDGET_DB_PATH=.elp_budget.sqlite3
# JSON optional output style; never log PII, prompts, supplier notes, or tokens.
ELP_LOG_LEVEL=INFO
ELP_JSON_LOGS=false
# External private denylist file path for local pre-push scans. Never commit the file.
# ELP_LOCAL_DENYLIST=/path/outside/repo/private-denylist.txt
# Future provider keys are deliberately absent from M0: no live provider adapter enabled.
